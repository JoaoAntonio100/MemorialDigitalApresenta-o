# URL de conexao do banco usada pela aplicacao.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# URL direta usada pelo Prisma para migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Credenciais administrativas e segredo de assinatura JWT.
JWT_SECRET="gere-um-segredo-longo-e-aleatorio"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-uma-senha-forte"
