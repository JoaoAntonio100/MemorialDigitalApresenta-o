# URL de conexao do banco usada pela aplicacao.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# URL direta usada pelo Prisma para migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Credenciais administrativas e segredo de assinatura JWT.
JWT_SECRET="gere-um-segredo-longo-e-aleatorio"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="$2b$12$gere-um-hash-com-bcrypt-de-12-rounds"

# Origens do frontend autorizadas, separadas por virgula e sem barra final.
CORS_ORIGINS="http://localhost:5173,https://seu-frontend.com"
