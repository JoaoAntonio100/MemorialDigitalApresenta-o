generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Memorial {
  id             Int      @id @default(autoincrement())
  nome           String
  biografia      String?
  descricao      String?
  dataNascimento String?
  dataMorte      String?
  localizacao    String?
  tipo           String?  @default("historica")
  imagem         String?
  galeria        String[] @default([])
  createdAt      DateTime @default(now())
}
